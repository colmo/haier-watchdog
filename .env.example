# Cuenta de la app hOn (la misma que en el móvil)
HON_EMAIL=tu-email@ejemplo.com
HON_PASSWORD='tu-contraseña'

# Opcional: nombre, modelo o MAC del AC si hay varios
# HON_APPLIANCE=Salón

# Bot de Telegram (BotFather) y tu chat_id
# Para obtener el chat_id: python -m haier_watchdog.chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Intervalo de consulta y tiempo para responder (segundos)
POLL_INTERVAL_SECONDS=900
CONFIRM_TIMEOUT_SECONDS=300

# 1 = avisa y simula el apagado, sin mandar el comando a hOn
DRY_RUN=0

# Opcional: directorio de logs (por defecto ./logs; en Docker, /app/logs)
# LOG_DIR=/var/log/haier-watchdog

# Zona horaria para las horas del mensaje
TZ=Europe/Madrid

# Docker Compose (solo en el VPS; no hace falta en la prueba con venv)
# IMAGE_NAME=ghcr.io/colmo/haier-watchdog
IMAGE_TAG=1.0.2
